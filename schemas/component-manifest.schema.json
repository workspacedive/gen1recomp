{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gen1recomp.local/schemas/component-manifest.schema.json",
  "title": "Gen1Recomp Component Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "version",
    "apiVersion",
    "artifact",
    "dependencies",
    "compatibility",
    "capabilities",
    "migrations",
    "selfTests"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"
    },
    "kind": {
      "enum": [
        "host",
        "platform",
        "runtime",
        "lua",
        "compatibility",
        "love2d",
        "kernel",
        "core",
        "mod-api",
        "mod",
        "ui",
        "renderer"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "apiVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "integrity"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "(^/|(?:^|/)\\.\\.(?:/|$))" }
        },
        "size": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "digest"],
          "properties": {
            "algorithm": { "const": "sha256" },
            "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "range"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"
          },
          "range": { "type": "string", "minLength": 1 },
          "optional": { "type": "boolean" }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9._-]*$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "migrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to", "entry"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "entry": { "type": "string", "minLength": 1 }
        }
      }
    },
    "selfTests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "entry", "timeoutMs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "entry": { "type": "string", "minLength": 1 },
          "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
        }
      }
    }
  }
}
